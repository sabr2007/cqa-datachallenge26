# Не загружать в деплой. По документации Vercel загружает все файлы проекта, кроме
# встроенных исключений и этого списка, а Python-функция включает всё, что загружено.
# Правило действует и для `vercel deploy`, и для деплоя из Git.

# Локальные выгрузки датасета и локальное хранилище оценок: там реальные диалоги.
/data/
/.data/

# В рантайме не нужны: тесты, служебные скрипты, прогоны точности, документы.
# (eval/gold.json, eval/split.json и eval/expert_pairs.json нужны — метрики точности.)
/tests/
/scripts/
/eval/runs/
/docs/

# Кеши и рабочие папки инструментов.
.pytest_cache/
.ruff_cache/
/.gstack/
/.claude/
/.playwright-mcp/

# Секреты
.env
.env.*
